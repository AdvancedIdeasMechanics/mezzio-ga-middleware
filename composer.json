  "description": "Mezzio Middleware for Google Analytics Web Rendering",
  "type": "library",
  "minimum-stability": "stable",
  "license": "MIT",
  "keywords": [
    "matthewpallotta",
    "advancedideasmechanics",
    "mezzio",
    "php",
    "library",
    "google",
    "analytics",
    "middleware",
    "psr-15"
  ],
  "authors": [
    {
      "name": "Matthew Pallotta",
      "email": "matt@advanced.im",
      "homepage": "https://advanced.im"
    }
  ],
  "support": {
    "issues": "https://github.com/AdvancedIdeasMechanics/mezzio-ga-middleware/issues",
    "email": "support@advanced.im",
    "source": "https://github.com/AdvancedIdeasMechanics/mezzio-ga-middleware",
    "docs": "https://support.advanced.im"
  },
  "homepage": "https://advanced.im/products/mezzio-ga-middleware",
  "require": {
    "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
    "psr/http-server-middleware": "^1.0.0",
    "mezzio/mezzio-template": "^2.0 || ^3.0",
    "mezzio/mezzio-router": "^3.0 || ^4.0",
    "laminas/laminas-diactoros": "3.8.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-master"
